# Railway PostgreSQL – sdílená instance s projektem DMS.
# DŮLEŽITÉ: ?schema=schvaleem drží naše tabulky v odděleném schématu.
# Lokálně použij veřejnou proxy URL, na Railway interní (postgres.railway.internal).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?schema=schvaleem"

# Tajný klíč pro podpis/expiraci session (vygeneruj: openssl rand -hex 32)
SESSION_SECRET="change-me"

# Base URL aplikace (pro odkazy), např. https://schvaleem.up.railway.app
APP_URL="http://localhost:3000"
