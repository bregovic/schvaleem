          Name                #TrvRequisitionTransportType
          Table               #TrvRequisitionTransportType
          UseDefaultRoleNames #Yes
        ENDPROPERTIES
        
        FIELDREFERENCES
          REFERENCETYPE PKFK
          PROPERTIES
            Field               #TrvRequisitionTransportTypeId
            RelatedField        #RecId
          ENDPROPERTIES
          
        ENDFIELDREFERENCES
      ENDREFERENCE
      REFERENCE #TrvTravelTxt
        PROPERTIES
          Name                #TrvTravelTxt
          Table               #TrvTravelTxt
          Validate            #No
          RelatedTableCardinality   #ZeroOne
          Cardinality         #ZeroMore
          RelationshipType    #Association
          UseDefaultRoleNames #Yes
          EDTRelation         #Yes
        ENDPROPERTIES
        
        FIELDREFERENCES
          REFERENCETYPE PKFK
          PROPERTIES
            Field               #ReferenceDataAreaId
            RelatedField        #dataAreaId
          ENDPROPERTIES
          
          REFERENCETYPE PKFK
          PROPERTIES
            Field               #TravelPurpose
            RelatedField        #Txt
            SourceEDT           #TrvTravelTxtEDT
          ENDPROPERTIES
          
        ENDFIELDREFERENCES
      ENDREFERENCE
    ENDREFERENCES
    
    DELETEACTIONS
      #SourceDocumentHeader
      PROPERTIES
        Table               #SourceDocumentHeader
        DeleteAction        #Cascade
      ENDPROPERTIES
      
      #TrvPolicyViolationJustification
      PROPERTIES
        Table               #TrvPolicyViolationJustification
        DeleteAction        #Cascade
      ENDPROPERTIES
      
      #TrvPolicyViolationsCache
      PROPERTIES
        Table               #TrvPolicyViolationsCache
        DeleteAction        #Cascade
      ENDPROPERTIES
      
      #TrvPolicyViolationsLog(TrvRequisitionTable)
      PROPERTIES
        Table               #TrvPolicyViolationsLog
        DeleteAction        #Cascade
        Relation            #TrvRequisitionTable
      ENDPROPERTIES
      
      #TrvRequisitionLine
      PROPERTIES
        Table               #TrvRequisitionLine
        DeleteAction        #Cascade
      ENDPROPERTIES
      
    ENDDELETEACTIONS
    
