// =====================================================================================
//  Schvaleem – generátor testovacího JSON z AX 2012
//  Zadáš číslo/čísla faktury + cílový adresář -> vygeneruje hezky odsazený JSON
//  přesně ve formátu, který bude AX posílat na API schvaleem (POST /api/workitems)
//  a uloží ho do souboru. 1 objekt v poli = 1 workitem.
//
//  Zdroje: VendInvoiceInfoTable, VendTable, VendBankAccount,
//          WorkflowTrackingStatusTable, WorkflowWorkItemTable
//
//  Názvy polí/metod ověřeny proti reálným XPO exportům (CZ lokalizace):
//    - číslo faktury .................. VendInvoiceInfoTable.Num (EDT InvoiceId)
//    - popis faktury .................. VendInvoiceInfoTable.Description
//    - měna ........................... VendInvoiceInfoTable.CurrencyCode
//    - celkem k úhradě ................ VendInvoiceInfoTable.dispTotalAmountToPay()
//    - datum dokladu / splatnost ...... DocumentDate / FixedDueDate
//    - IČO ............................ VendTable.RegNum_W (pole, NE metoda regNum())
//    - název dodavatele ............... VendTable.name()
//    - bankovní účet .................. VendBankAccount.AccountNum / BankGroupId / BankIBAN
//    - instrukce workitemu ............ WorkflowWorkItemTable.Description
//    - vazba workitem<->instance ...... CorrelationId == CorrelationId
//    - aktivní stav ................... WorkflowWorkItemStatus::Pending
//
//  Pozn.: v X++ musí být VŠECHNY deklarace proměnných na začátku metody,
//  před prvním výkonným příkazem (proto níže nejsou deklarace uvnitř cyklů).
// =====================================================================================
static void Schvaleem_GenInvoiceJson(Args _args)
{
    VendInvoiceInfoTable        vendInvoiceInfoTable;
    VendTable                   vendTable;
    VendBankAccount             vendBankAccount;
    WorkflowTrackingStatusTable wfStatus;
    WorkflowWorkItemTable       wfWorkItem;

    Dialog      dialog;
    DialogField dfNums;
    DialogField dfDir;
    container   invoiceNums;
    str         numsRaw;
    str         dir;
    str         fileName;
    str         stamp;
    str         itemsJson;     // těla objektů oddělená ",\n"
    str         valuesJson;
    str         obj;
    str         jsonOut;
    InvoiceId   invoiceNo;      // vázaný string (EDT) – nutné pro použití ve WHERE
    int         i;
    int         itemCount;

    // Odsazení (pretty JSON)
    #define.NL('\n')
    #define.I2('  ')
    #define.I4('    ')
    #define.I6('      ')

    // -------------------------------------------------------------------------
    // JSON helpery (lokální funkce) – musí být před prvním výkonným příkazem
    // -------------------------------------------------------------------------
    str jsonEsc(str _s)
    {
        str s = _s;
        s = strReplace(s, @'\', @'\\');
        s = strReplace(s, '"', '\"');
        s = strReplace(s, '\n', ' ');
        s = strReplace(s, '\r', '');
        s = strReplace(s, '\t', ' ');
        return s;
    }
    str q(str _s)   { return '"' + jsonEsc(_s) + '"'; }                 // hodnota "text"

    // řádek "klíč": hodnota  (hodnota už je hotový JSON – string i raw)
    str fl(str _ind, str _k, str _v) { return _ind + q(_k) + ': ' + _v; }

    // utcDateTime -> "ISO" (UTC) nebo null. Parser appky zvládne ISO i dd.MM.yyyy.
    str dtv(utcDateTime _u)
    {
        if (_u == utcDateTimeNull())
            return 'null';
        return q(DateTimeUtil::toStr(_u));
    }

    // date -> "dd.MM.yyyy" nebo null
    str datev(date _d)
    {
        if (!_d)
            return 'null';
        return q(date2str(_d, 321,
                          DateDay::Digits2, DateSeparator::Dot,
                          DateMonth::Digits2, DateSeparator::Dot,
                          DateYear::Digits4));
    }

    // real -> JSON číslo s desetinnou tečkou, 2 desetinná místa
    str numv(real _a)
    {
        return strReplace(num2str(_a, 0, 2, 1, 0), ',', '.');
    }

    // Číslo účtu v českém formátu: číslo/směrovýkód.
    // Směrový kód banky (CZ) = VendBankAccount.RegistrationNum (EDT BankRegNum).
    str bankAccountStr(VendBankAccount _vba)
    {
        str acc      = _vba.AccountNum;        // číslo účtu (EDT BankAccount)
        str bankCode = _vba.RegistrationNum;   // směrový kód banky (CZ)
        if (bankCode)
            return acc + '/' + bankCode;
        return acc;
    }

    // Rozdělí text podle oddělovače na container ŘETĚZCŮ.
    // (Nelze použít str2con – ten číselné tokeny převede na čísla a uřízne
    //  vodící nuly, např. "0030400626" -> 30400626.)
    container splitStr(str _s, str _sep)
    {
        container c = conNull();
        str       rest = _s;
        int       idx;
        while (rest)
        {
            idx = strFind(rest, _sep, 1, strLen(rest));
            if (!idx)
            {
                c += strLRTrim(rest);
                break;
            }
            c   += strLRTrim(subStr(rest, 1, idx - 1));
            rest = subStr(rest, idx + strLen(_sep), strLen(rest));
        }
        return c;
    }

    // -------------------------------------------------------------------------
    // Vstup: čísla faktur + cílový adresář
    // -------------------------------------------------------------------------
    dialog = new Dialog("Schvaleem – generátor testovacího JSON");
    dfNums = dialog.addField(extendedTypeStr(InvoiceId), "Čísla faktur (oddělená čárkou)");
    dfDir  = dialog.addField(extendedTypeStr(FilePath),  "Cílový adresář (prázdné = jen vypsat)");
    if (!dialog.run())
        return;

    numsRaw     = dfNums.value();
    dir         = dfDir.value();
    invoiceNums = splitStr(numsRaw, ",");   // ŘETĚZCE – zachová vodící nuly

    // -------------------------------------------------------------------------
    // Hlavní smyčka přes faktury
    // -------------------------------------------------------------------------
    for (i = 1; i <= conLen(invoiceNums); i++)
    {
        invoiceNo = strLRTrim(conPeek(invoiceNums, i));
        if (!invoiceNo)
            continue;

        // Faktura v evidenci přijatých faktur (deník schvalování)
        select firstOnly vendInvoiceInfoTable
            where vendInvoiceInfoTable.Num == invoiceNo;
        if (!vendInvoiceInfoTable.RecId)
        {
            warning(strFmt("Faktura %1 nenalezena ve VendInvoiceInfoTable.", invoiceNo));
            continue;
        }

        // Dodavatel + bankovní účet
        vendTable = VendTable::find(vendInvoiceInfoTable.InvoiceAccount);
        select firstOnly vendBankAccount
            where vendBankAccount.VendAccount == vendTable.AccountNum
               && vendBankAccount.AccountID  == vendTable.BankAccount;

        // Hodnoty dokladu (values) – odsazené na I6
        valuesJson =
            '{' + #NL
          + fl(#I6, 'Číslo faktury',     q(vendInvoiceInfoTable.Num)) + ',' + #NL
          + fl(#I6, 'Dodavatel',         q(vendTable.name())) + ',' + #NL
          + fl(#I6, 'IČO',               q(vendTable.RegNum_W)) + ',' + #NL
          + fl(#I6, 'Popis faktury',     q(vendInvoiceInfoTable.Description)) + ',' + #NL
          + fl(#I6, 'Bankovní účet',     q(bankAccountStr(vendBankAccount))) + ',' + #NL
          + fl(#I6, 'IBAN',              q(vendBankAccount.BankIBAN)) + ',' + #NL
          + fl(#I6, 'Měna',              q(vendInvoiceInfoTable.CurrencyCode)) + ',' + #NL
          + fl(#I6, 'Datum dokladu',     datev(vendInvoiceInfoTable.DocumentDate)) + ',' + #NL
          + fl(#I6, 'Datum splatnosti',  datev(vendInvoiceInfoTable.FixedDueDate)) + ',' + #NL
          + fl(#I6, 'Celkem k úhradě',   numv(vendInvoiceInfoTable.dispTotalAmountToPay())) + #NL
          + #I4 + '}';

        // Workflow instance navázaná na fakturu (nejnovější)
        select firstOnly wfStatus
            order by wfStatus.createdDateTime desc
            where wfStatus.ContextTableId == tableNum(VendInvoiceInfoTable)
               && wfStatus.ContextRecId   == vendInvoiceInfoTable.RecId;
        if (!wfStatus.RecId)
        {
            warning(strFmt("K faktuře %1 nebyl nalezen workflow.", invoiceNo));
            continue;
        }

        // Každý aktivní (čekající) workitem -> jeden JSON objekt
        // Vazba na instanci je shodné CorrelationId (formální FK mezi tabulkami není).
        while select wfWorkItem
            where wfWorkItem.CorrelationId == wfStatus.CorrelationId
               && wfWorkItem.Status        == WorkflowWorkItemStatus::Pending
        {
            obj =
                #I2 + '{' + #NL
              + fl(#I4, 'workflowId',       q(guid2str(wfStatus.RootCorrelationId))) + ',' + #NL
              + fl(#I4, 'workitemId',       q(int642str(wfWorkItem.RecId))) + ',' + #NL
              + fl(#I4, 'dataArea',         q(wfStatus.ContextCompanyId)) + ',' + #NL
              + fl(#I4, 'documentType',     q(int2str(wfStatus.ContextTableId))) + ',' + #NL
              + fl(#I4, 'recordId',         q(int642str(wfStatus.ContextRecId))) + ',' + #NL
              + fl(#I4, 'assigneeUserId',   q(wfWorkItem.UserId)) + ',' + #NL
              + fl(#I4, 'documentTypeName', q(tableId2name(wfStatus.ContextTableId))) + ',' + #NL
              + fl(#I4, 'documentLabel',    q(strFmt("Faktura %1 – %2", vendInvoiceInfoTable.Num, vendTable.name()))) + ',' + #NL
              + fl(#I4, 'originator',       q(wfStatus.Originator)) + ',' + #NL
              + fl(#I4, 'trackingStatus',   q(enum2str(wfStatus.TrackingStatus))) + ',' + #NL
              + fl(#I4, 'createdDateTime',  dtv(wfStatus.createdDateTime)) + ',' + #NL
              + fl(#I4, 'subject',          q(wfWorkItem.Subject)) + ',' + #NL
              + fl(#I4, 'description',      q(wfWorkItem.Description)) + ',' + #NL
              + fl(#I4, 'dueDateTime',      dtv(wfWorkItem.DueDateTime)) + ',' + #NL
              + fl(#I4, 'workitemStatus',   q(enum2str(wfWorkItem.Status))) + ',' + #NL
              + fl(#I4, 'documents',        '[]') + ',' + #NL   // sem doplň názvy příloh, např. ["faktura.pdf"]
              + fl(#I4, 'values',           valuesJson) + #NL
              + #I2 + '}';

            if (itemsJson)
                itemsJson += ',' + #NL;
            itemsJson += obj;
            itemCount++;
        }
    }

    // -------------------------------------------------------------------------
    // Výstup
    // -------------------------------------------------------------------------
    if (!itemCount)
    {
        warning("Nebyl vygenerován žádný workitem.");
        return;
    }

    jsonOut = '[' + #NL + itemsJson + #NL + ']';

    if (dir)
    {
        // ořež koncové zpětné lomítko
        if (subStr(dir, strLen(dir), 1) == @'\')
            dir = subStr(dir, 1, strLen(dir) - 1);

        // časové razítko yyyyMMdd_HHmmss (bez znaků zakázaných v názvu souboru)
        stamp = date2str(today(), 321,
                         DateDay::Digits2,  DateSeparator::None,
                         DateMonth::Digits2, DateSeparator::None,
                         DateYear::Digits4)
              + '_' + strReplace(time2str(timeNow(), TimeSeparator::Colon, TimeFormat::Hour24), ':', '');

        fileName = dir + @'\schvaleem_workitems_' + stamp + '.json';

        // zápis UTF-8 (bez BOM) přes .NET – správná diakritika
        new InteropPermission(InteropKind::ClrInterop).assert();
        System.IO.File::WriteAllText(fileName, jsonOut, new System.Text.UTF8Encoding(false));
        CodeAccessPermission::revertAssert();

        info(strFmt("Vygenerováno workitemů: %1. JSON uložen: %2", itemCount, fileName));
    }
    else
    {
        info(strFmt("Vygenerováno workitemů: %1", itemCount));
        info(jsonOut);
    }
}
